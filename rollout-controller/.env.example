# Graceful shutdown timeout
SHUTDOWN_TIMEOUT=30s

# Server
SERVER_HOST=localhost
SERVER_PORT=8090
SERVER_TIMEOUT=30s

# Cache
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_READ_TIMEOUT=500ms
CACHE_WRITE_TIMEOUT=500ms

# Cache TTL
CACHE_CAMPAIGN_EVENT_ID_SEEN_TTL=24h

# Broker
BROKER_HOST=localhost
BROKER_PORT=29092
BROKER_GROUP_ID=your-group-id
BROKER_TIMEOUT=10s

# Broker Writer
BROKER_BATCH_TIMEOUT=10ms

# Broker Reader
BROKER_MIN_BYTES=1
BROKER_READER_MAX_WAIT=1s
BROKER_COMMIT_TIMEOUT=2s

# Broker DLQ
BROKER_DLQ_TIMEOUT=5s
BROKER_DLQ_MAX_ATTEMPTS=3

# Evaluator
EVALUATOR_FREQUENCY=10s
EVALUATOR_REQUIRED_STABLE_CYCLES=3
