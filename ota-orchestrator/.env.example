# Graceful shutdown timeout
SHUTDOWN_TIMEOUT=30s

# HTTP Server
HTTP_SERVER_HOST=localhost
HTTP_SERVER_PORT=8080
HTTP_SERVER_TIMEOUT=15s

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_service_user
DB_PASSWORD=your_password
DB_NAME=your_db
DB_SSL_MODE=disable

# Database Pool
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=5m
DB_MAX_CONN_LIFETIME_JITTER=5m
DB_REQUEST_TIMEOUT=30s
DB_PAGINATION_LIMIT=100

# Cache
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_READ_TIMEOUT=500ms
CACHE_WRITE_TIMEOUT=500ms

# Cache TTL
CACHE_DEVICE_CHECKIN_DATA_TTL=24h

# Broker
BROKER_HOST=localhost
BROKER_PORT=29092
BROKER_GROUP_ID=ota-orchestrator-group
BROKER_TIMEOUT=10s
BROKER_BUFFER_SIZE=100

# Broker Writer
BROKER_BATCH_TIMEOUT=10ms

# Broker Reader
BROKER_MIN_BYTES=1
BROKER_READER_MAX_WAIT=1s
BROKER_COMMIT_TIMEOUT=2s

# Broker DLQ
BROKER_DLQ_TIMEOUT=5s
BROKER_DLQ_MAX_ATTEMPTS=3

# Rollout Controller Client
ROLLOUT_CONTROLLER_SCHEME=http
ROLLOUT_CONTROLLER_HOST=localhost
ROLLOUT_CONTROLLER_PORT=8090
ROLLOUT_CONTROLLER_TIMEOUT=30s
