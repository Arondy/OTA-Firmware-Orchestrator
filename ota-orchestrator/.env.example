# HTTP Server
HTTP_SERVER_HOST=localhost
HTTP_SERVER_PORT=8080
HTTP_SERVER_TIMEOUT=15s

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_service_user
DB_PASSWORD=your_password
DB_NAME=your_db
DB_SSL_MODE=disable

# Database Pool
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=5m
DB_MAX_CONN_LIFETIME_JITTER=5m
REQUEST_TIMEOUT=30s
